{
  "name": "runply",
  "version": "0.3.0",
  "description": "An application framework for agents. Offline-first development, explicit contracts, inspectable runs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runply/runply.git"
  },
  "homepage": "https://github.com/runply/runply#readme",
  "bugs": {
    "url": "https://github.com/runply/runply/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "runply": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./example": {
      "types": "./dist/example.d.ts",
      "import": "./dist/example.js"
    }
  },
  "files": [
    "dist",
    "src",
    "templates",
    "docs",
    "tests",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build",
    "typecheck": "tsc -p tsconfig.check.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "acceptance": "node scripts/acceptance.mjs",
    "acceptance:inspector": "npm run build && node scripts/inspector-acceptance.mjs",
    "start": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.34",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ai": "7.0.155",
    "ajv": "8.20.0",
    "chokidar": "4.0.3",
    "npm-packlist": "10.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.90",
    "@ai-sdk/openai": "4.0.104",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
